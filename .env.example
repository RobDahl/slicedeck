# Copy to .env and fill in. .env is gitignored - never commit real credentials.

# --- Frame source ---
# One of: reolink | mjpeg | image_url | video_file | synthetic
SLICEDECK_SOURCE=synthetic

# Reolink IP camera (source=reolink)
REOLINK_HOST=192.168.1.100
REOLINK_USER=admin
REOLINK_PASSWORD=
REOLINK_CHANNEL=0

# Generic MJPEG stream (source=mjpeg)
MJPEG_URL=

# Single still image re-fetched each tick, e.g. a NOAA/NASA satellite still (source=image_url)
IMAGE_URL=

# Local video file, looped (source=video_file)
VIDEO_FILE=

# --- Deck geometry ---
# mini | mk2 | xl | plus  (or set SLICEDECK_GRID_COLS/ROWS + KEY_PX to override)
SLICEDECK_DECK=xl

# --- Pipeline ---
SLICEDECK_FPS=2.0
SLICEDECK_FILTERS=
SLICEDECK_MOTION=true
SLICEDECK_MOTION_THRESHOLD=12.0
SLICEDECK_JPEG_QUALITY=85
SLICEDECK_OUTPUT_DIR=streamdeck_slices

# --- HTTP server ---
SLICEDECK_HOST=127.0.0.1
SLICEDECK_PORT=8080
# Comma-separated origins allowed to hit the API. * is fine for a LAN-only demo.
SLICEDECK_CORS_ORIGINS=*
